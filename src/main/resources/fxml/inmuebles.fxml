<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.InmuebleController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar inmuebles" onAction="#cargarInmuebles"/>
        <Button text="Nuevo inmueble" onAction="#abrirFormularioNuevoInmueble"/>
        <Button text="Editar inmueble" onAction="#abrirFormularioEditarInmueble"/>
        <Button text="Ver detalle" onAction="#verDetalleInmueble"/>
        <Button text="Imágenes" onAction="#administrarImagenes"/>
        <Button text="Cambiar estado" onAction="#cambiarEstadoInmueble"/>
        <Button text="Eliminar inmueble" onAction="#eliminarInmueble"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaInmuebles" prefHeight="400">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="180"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colPrecio" text="Renta" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>