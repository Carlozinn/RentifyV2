<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.ImagenesInmuebleController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Administrar imágenes del inmueble"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Imagen:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <HBox spacing="10"
              GridPane.rowIndex="0"
              GridPane.columnIndex="1">

            <Button text="Seleccionar imagen"
                    onAction="#seleccionarImagen"/>

            <Label fx:id="lblArchivoSeleccionado"
                   text="Ningún archivo seleccionado"/>
        </HBox>

        <Label text="Vista previa:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <ImageView fx:id="imgPreview"
                   fitWidth="220"
                   fitHeight="150"
                   preserveRatio="true"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Descripción:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDescripcion"
                   promptText="Vista principal"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Orden visualización:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtOrdenVisualizacion"
                   promptText="Se asigna automáticamente si lo dejas vacío"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkEsPrincipal"
                  text="Marcar como imagen principal"
                  GridPane.rowIndex="4"
                  GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">

        <Button text="Agregar imagen"
                onAction="#agregarImagen"/>

        <Button text="Marcar principal"
                onAction="#marcarPrincipal"/>

        <Button text="Eliminar imagen"
                onAction="#eliminarImagen"/>

        <Button text="Recargar"
                onAction="#cargarImagenes"/>

        <Button text="Volver"
                onAction="#volver"/>

    </HBox>

    <TableView fx:id="tablaImagenes" prefHeight="350">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colUrl"
                         text="URL Imagen"
                         prefWidth="320"/>

            <TableColumn fx:id="colDescripcion"
                         text="Descripción"
                         prefWidth="180"/>

            <TableColumn fx:id="colPrincipal"
                         text="Principal"
                         prefWidth="90"/>

            <TableColumn fx:id="colOrdenVisualizacion"
                         text="Orden"
                         prefWidth="80"/>

        </columns>

    </TableView>

    <Label fx:id="lblMensaje"
           style="-fx-text-fill: red;"/>

</VBox>