<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.InmuebleFormController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Registro de inmueble" styleClass="titulo"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtDescripcion" prefRowCount="3" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Calle:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCalle" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Número exterior:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNumeroExterior" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Número interior:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNumeroInterior" promptText="Si no tiene, escribe S/N" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Colonia:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtColonia" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Ciudad:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCiudad" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Estado/Provincia:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEstadoProvincia" prefWidth="250" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Código postal:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodigoPostal" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

        <Label text="Precio renta:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecioRenta" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <Label text="Superficie m2:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSuperficie" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

        <Label text="Habitaciones:" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
        <TextField fx:id="txtHabitaciones" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

        <Label text="Baños:" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
        <TextField fx:id="txtBanos" GridPane.rowIndex="12" GridPane.columnIndex="1"/>

        <Label text="Estacionamientos:" GridPane.rowIndex="13" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEstacionamientos" GridPane.rowIndex="13" GridPane.columnIndex="1"/>

        <Label text="Tipo inmueble:" GridPane.rowIndex="14" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbTipoInmueble" prefWidth="200" GridPane.rowIndex="14" GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkMascotas" text="Mascotas permitidas" GridPane.rowIndex="15" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardarInmueble"/>
        <Button text="Cancelar" onAction="#cancelar" styleClass="button-secundario"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" styleClass="mensaje-error"/>

</VBox>