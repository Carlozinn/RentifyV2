<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rentify.controller.ArrendadorController">

    <content>
        <VBox spacing="25"
              alignment="TOP_CENTER"
              style="-fx-background-color: #f4f6fb;">

            <padding>
                <Insets top="30" right="40" bottom="40" left="40"/>
            </padding>

            <VBox spacing="8"
                  alignment="CENTER"
                  style="-fx-background-color: white;
                         -fx-background-radius: 18;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);"
                  prefWidth="950">

                <Label text="Panel de Arrendador"
                       style="-fx-font-size: 28px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <Label fx:id="lblBienvenida"
                       text="Bienvenido."
                       style="-fx-font-size: 16px;
                              -fx-text-fill: #475569;"/>
            </VBox>

            <VBox spacing="15"
                  prefWidth="950">

                <Label text="Resumen general"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <GridPane hgap="15" vgap="15">

                    <VBox spacing="8"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Inmuebles registrados"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblInmueblesRegistrados"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Disponibles"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblInmueblesDisponibles"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="2"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Ocupados"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblInmueblesOcupados"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Solicitudes pendientes"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblSolicitudesPendientes"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f97316;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Arrendamientos activos"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblArrendamientosActivos"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="2"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Contratos firmados"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblContratosFirmados"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                    </VBox>

                    <VBox spacing="5"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Pagos pendientes"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblPagosPendientes"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        <Label fx:id="lblMontoPagosPendientes"
                               text="\$0.00"
                               style="-fx-font-size: 14px; -fx-text-fill: #16a34a;"/>
                    </VBox>

                    <VBox spacing="5"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Pagos vencidos"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblPagosVencidos"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <Label fx:id="lblMontoPagosVencidos"
                               text="\$0.00"
                               style="-fx-font-size: 14px; -fx-text-fill: #dc2626;"/>
                    </VBox>

                    <VBox spacing="8"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="2"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);"
                          prefWidth="290">
                        <Label text="Incidencias abiertas"
                               style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>
                        <Label fx:id="lblIncidenciasAbiertas"
                               text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f97316;"/>
                    </VBox>

                </GridPane>
            </VBox>

            <VBox spacing="15"
                  prefWidth="950"
                  style="-fx-background-color: white;
                         -fx-background-radius: 18;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0, 0, 3);">

                <Label text="Módulos"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <GridPane hgap="15" vgap="15">

                    <Button text="Gestionar inmuebles"
                            onAction="#abrirGestionInmuebles"
                            prefWidth="290"
                            prefHeight="45"/>

                    <Button text="Ver solicitudes"
                            onAction="#abrirSolicitudes"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.columnIndex="1"/>

                    <Button text="Ver arrendamientos"
                            onAction="#abrirArrendamientos"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.columnIndex="2"/>

                    <Button text="Ver contratos"
                            onAction="#abrirContratos"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"/>

                    <Button text="Ver pagos"
                            onAction="#abrirPagos"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"/>

                    <Button text="Incidencias"
                            onAction="#abrirIncidencias"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2"/>

                    <Button text="Mis contactos"
                            onAction="#abrirContactos"
                            prefWidth="290"
                            prefHeight="45"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"/>

                    <Button text="Cerrar sesión"
                            onAction="#cerrarSesion"
                            prefWidth="290"
                            prefHeight="45"
                            styleClass="button-secundario"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"/>

                </GridPane>
            </VBox>

        </VBox>
    </content>
</ScrollPane>