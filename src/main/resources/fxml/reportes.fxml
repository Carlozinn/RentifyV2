<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.ReportesController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar reportes" onAction="#cargarReportes"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaReportes" prefHeight="450">
        <columns>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="220"/>
            <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="220"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>