<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rentify.controller.InmuebleDetalleController">

    <content>
        <VBox spacing="18"
              styleClass="panel-card">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Detalle inmueble"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <ImageView fx:id="imgPrincipal"
                       fitWidth="460"
                       fitHeight="280"
                       preserveRatio="true"
                       smooth="true"/>

            <Label fx:id="lblMensaje"
                   style="-fx-text-fill: red;"/>

            <GridPane hgap="15" vgap="12">

                <Label text="Título:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblTitulo"
                       wrapText="true"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Descripción:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblDescripcion"
                       wrapText="true"
                       prefWidth="650"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Tipo:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblTipo"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <Label text="Estado:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblEstado"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

                <Label text="Renta mensual:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblPrecioRenta"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="1"/>

                <Label text="Dirección:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblDireccion"
                       wrapText="true"
                       prefWidth="650"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="1"/>

                <Label text="Ciudad:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblCiudad"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="1"/>

                <Label text="Estado / Provincia:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="7"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblEstadoProvincia"
                       GridPane.rowIndex="7"
                       GridPane.columnIndex="1"/>

                <Label text="Código postal:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="8"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblCodigoPostal"
                       GridPane.rowIndex="8"
                       GridPane.columnIndex="1"/>

                <Label text="Superficie:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="9"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblSuperficie"
                       GridPane.rowIndex="9"
                       GridPane.columnIndex="1"/>

                <Label text="Habitaciones:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="10"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblHabitaciones"
                       GridPane.rowIndex="10"
                       GridPane.columnIndex="1"/>

                <Label text="Baños:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="11"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblBanos"
                       GridPane.rowIndex="11"
                       GridPane.columnIndex="1"/>

                <Label text="Estacionamientos:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="12"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblEstacionamientos"
                       GridPane.rowIndex="12"
                       GridPane.columnIndex="1"/>

                <Label text="Mascotas:"
                       style="-fx-font-weight: bold;"
                       GridPane.rowIndex="13"
                       GridPane.columnIndex="0"/>

                <Label fx:id="lblMascotas"
                       GridPane.rowIndex="13"
                       GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">
                <Button text="Volver"
                        onAction="#volver"
                        styleClass="button-secundario"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>