<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.LoginController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Iniciar sesión en Rentify" styleClass="titulo"/>

    <TextField fx:id="txtUsername" promptText="Username" maxWidth="250"/>

    <PasswordField fx:id="txtPassword" promptText="Contraseña" maxWidth="250"/>
    <TextField fx:id="txtPasswordVisible" promptText="Contraseña" maxWidth="250" visible="false" managed="false"/>

    <CheckBox fx:id="chkMostrarPassword" text="Mostrar contraseña" onAction="#toggleMostrarPassword"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Iniciar sesión" onAction="#iniciarSesion"/>
        <Button text="Registrarse" onAction="#abrirRegistro" styleClass="button-secundario"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" styleClass="mensaje-error"/>

</VBox>