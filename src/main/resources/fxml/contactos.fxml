<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.ContactosController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mis contactos"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Tipo de contacto:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cmbTipoContacto"
                  prefWidth="220"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>

        <Label text="Contacto:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtValorContacto"
                   promptText="correo@ejemplo.com / teléfono / WhatsApp"
                   prefWidth="320"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkPrincipal"
                  text="Marcar como principal"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">
        <Button text="Agregar contacto"
                onAction="#agregarContacto"/>

        <Button text="Marcar principal"
                onAction="#marcarPrincipal"/>

        <Button text="Eliminar contacto"
                onAction="#eliminarContacto"/>

        <Button text="Recargar"
                onAction="#cargarContactos"/>

        <Button text="Volver"
                onAction="#volver"
                styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaContactos" prefHeight="350">
        <columns>
            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colTipo"
                         text="Tipo"
                         prefWidth="150"/>

            <TableColumn fx:id="colValor"
                         text="Contacto"
                         prefWidth="260"/>

            <TableColumn fx:id="colPrincipal"
                         text="Principal"
                         prefWidth="100"/>

            <TableColumn fx:id="colVerificado"
                         text="Verificado"
                         prefWidth="100"/>
        </columns>
    </TableView>

    <Label fx:id="lblMensaje"
           style="-fx-text-fill: red;"/>

</VBox>