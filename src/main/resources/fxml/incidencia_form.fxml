<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.IncidenciaFormController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Registrar incidencia" styleClass="titulo"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Arrendamiento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbArrendamiento" prefWidth="280" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Título:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtDescripcion" prefRowCount="4" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Prioridad:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPrioridad" prefWidth="200" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardarIncidencia"/>
        <Button text="Cancelar" onAction="#cancelar" styleClass="button-secundario"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" styleClass="mensaje-error"/>

</VBox>