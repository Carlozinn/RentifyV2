<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.PagosController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar pagos" onAction="#cargarPagos"/>
        <Button fx:id="btnPagar" text="Pagar" onAction="#pagarPago"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaPagos" prefHeight="420">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
            <TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="140"/>
            <TableColumn fx:id="colContraparte" text="Contraparte" prefWidth="130"/>
            <TableColumn fx:id="colFechaVencimiento" text="Vencimiento" prefWidth="110"/>
            <TableColumn fx:id="colFechaPago" text="Fecha pago" prefWidth="140"/>
            <TableColumn fx:id="colPeriodo" text="Periodo" prefWidth="80"/>
            <TableColumn fx:id="colMonto" text="Monto" prefWidth="90"/>
            <TableColumn fx:id="colMetodoPago" text="Método" prefWidth="90"/>
            <TableColumn fx:id="colReferencia" text="Referencia" prefWidth="120"/>
            <TableColumn fx:id="colComprobante" text="Comprobante" prefWidth="130"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>