<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.UsuarioController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar usuarios" onAction="#cargarUsuarios"/>
        <Button text="Nuevo usuario" onAction="#abrirFormularioNuevoUsuario"/>
        <Button text="Editar usuario" onAction="#abrirFormularioEditarUsuario"/>
        <Button text="Cambiar estado" onAction="#cambiarEstadoUsuario"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" prefHeight="400">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="colApellidoPaterno" text="Apellido paterno" prefWidth="140"/>
            <TableColumn fx:id="colApellidoMaterno" text="Apellido materno" prefWidth="140"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="120"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>