<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.ArrendamientosController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar arrendamientos" onAction="#cargarArrendamientos"/>
        <Button fx:id="btnGenerarPago" text="Generar pago" onAction="#abrirFormularioPago"/>
        <Button fx:id="btnGenerarContrato" text="Generar contrato" onAction="#abrirFormularioContrato"/>
        <Button fx:id="btnCambiarEstado" text="Cambiar estado" onAction="#cambiarEstadoArrendamiento"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaArrendamientos" prefHeight="420">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="180"/>
            <TableColumn fx:id="colContraparte" text="Contraparte" prefWidth="170"/>
            <TableColumn fx:id="colFechaInicio" text="Inicio" prefWidth="110"/>
            <TableColumn fx:id="colFechaFin" text="Fin" prefWidth="110"/>
            <TableColumn fx:id="colMonto" text="Monto mensual" prefWidth="130"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>