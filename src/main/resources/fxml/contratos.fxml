<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.ContratosController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar contratos" onAction="#cargarContratos"/>

        <Button fx:id="btnAbrirPdf"
                text="Abrir PDF"
                onAction="#abrirPdfContrato"/>

        <Button fx:id="btnFirmarContrato"
                text="Firmar contrato"
                onAction="#firmarContrato"/>

        <Button fx:id="btnCancelarContrato"
                text="Cancelar contrato"
                onAction="#cancelarContrato"/>

        <Button text="Volver"
                onAction="#volverAlPanel"
                styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaContratos" prefHeight="420">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colFolio" text="Folio" prefWidth="140"/>
            <TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="170"/>
            <TableColumn fx:id="colContraparte" text="Contraparte" prefWidth="170"/>
            <TableColumn fx:id="colFechaGeneracion" text="Generación" prefWidth="170"/>
            <TableColumn fx:id="colFechaFirma" text="Firma" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="colArchivo" text="Archivo" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>