<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rentify.controller.MisSolicitudesController"
      styleClass="panel-card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <Button text="Cargar solicitudes" onAction="#cargarSolicitudes"/>
        <Button text="Volver" onAction="#volverAlPanel" styleClass="button-secundario"/>
    </HBox>

    <TableView fx:id="tablaSolicitudes" prefHeight="420">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="220"/>
            <TableColumn fx:id="colMensaje" text="Mensaje" prefWidth="240"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="170"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>